{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdread",
  "version": "0.2.0",
  "identifier": "com.mdread.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mdread",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "decorations": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}